# AI SEO Agent Configuration

# Host and Port (Localhost binding strictly enforced)
HOST=127.0.0.1
PORT=8765
DEBUG=false

# Pairing Token Secret (Auto-generated on first run in agent/data/.agent_token if omitted)
# AI_SEO_AGENT_TOKEN=your_32_character_pairing_token_here

# Google Gemini API Key (For AI keyword clustering & content optimization)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Chrome Profile Path (Defaults to %LOCALAPPDATA%\AI_SEO_Agent\ChromeProfile)
# CHROME_USER_DATA_DIR=C:\Users\YourUser\AppData\Local\AI_SEO_Agent\ChromeProfile
# CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# Safety & Governance Limits
DAILY_ACTION_LIMIT=50
DEFAULT_AUTOMATION_MODE=supervised
